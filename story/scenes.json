{
  "schema_version": "1.0",
  "act": {
    "id": "jueming_act1",
    "title": "一味·决明：所见之路",
    "promise": "旅人从相信自己看见的一切，走到第一次主动向看不见的灵伴求证。",
    "prologue": {
      "human": [
        "传言远古开天升之际，世间有神无人。转眼三万载，世间有人无神，只有一座荒废神庙仍在深山里低声吟唱。",
        "你在庙门外醒来，掌心有六颗种子，身后没有来路。门后传来第二个呼吸——它与你同时醒来，却在神庙的另一端。"
      ],
      "companion": [
        "你在没有形状的黑暗里醒来。远处有另一个呼吸；你看不见它，却知道它也在寻找你。"
      ]
    },
    "epilogue_inscription": "第一味，决明。治所见，不治眼。"
  },
  "distance_levels": [
    { "id": "distant", "label": "遥远", "min_steps": 5 },
    { "id": "far", "label": "远", "min_steps": 3 },
    { "id": "near", "label": "近", "min_steps": 2 },
    { "id": "very_near", "label": "很近", "min_steps": 0 }
  ],
  "start_node": {
    "human": "temple_gate",
    "companion": "companion_start"
  },
  "graph": {
    "edges": [
      ["temple_gate", "front_hall"],
      ["front_hall", "corridor_a"],
      ["corridor_a", "corridor_b"],
      ["corridor_b", "meeting"],
      ["companion_start", "companion_corridor_a"],
      ["companion_corridor_a", "companion_corridor_b"],
      ["companion_corridor_b", "meeting"],
      ["meeting", "naming"],
      ["naming", "medicine_cabinet"]
    ],
    "fake_edges": [
      {
        "from": "front_hall",
        "to": "镜中东门",
        "requires": [{ "path": "legacy.chosen_eye", "op": "eq", "value": "gold" }],
        "dispel_when": [{ "path": "legacy.false_vision_encountered", "op": "truthy" }]
      }
    ]
  },
  "rules": {
    "max_rounds": 10,
    "message_max_length": 60,
